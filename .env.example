# Copy this file to .env and change the passwords before running on a server.

# Database
DB_PORT=3307
DB_NAME=kaksha
DB_USER=kaksha
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Port the web page is served on (80 on a server, anything free on a laptop)
WEB_PORT=80

# Address people use to reach the site. Used for the unsubscribe link in alert emails.
PUBLIC_URL=http://localhost

# Alert emails. Leave SMTP_HOST empty and emails are only written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=alerts@example.com

# Set to true to run one full screening right after start-up (the daily run is at 02:30 UTC anyway)
SCREEN_ON_STARTUP=false
